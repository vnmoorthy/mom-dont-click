# ── Mom, Don't Click ─ every key is optional; the app degrades gracefully ──
# With no keys at all it runs fully local: PGlite database, rule-based reader,
# local Chromium (or plain fetch) instead of a cloud browser, paste form instead of email.

# Public URL of this deployment (used in QR codes, emails and for the training pages)
PUBLIC_URL=http://localhost:3000

# Neon Postgres — https://neon.com  (falls back to in-process PGlite)
DATABASE_URL=

# Neon AI Gateway — OpenAI-compatible chat completions (falls back to rules)
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
LLM_MODEL=
LLM_VISION_MODEL=
# Optional alternatives if you are not on the Neon gateway
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# AgentMail — the forwardable address  https://agentmail.to
AGENTMAIL_API_KEY=
AGENTMAIL_USERNAME=momdontclick
AGENTMAIL_DISPLAY_NAME=Mom, Don't Click

# Kernel — the disposable cloud browser  https://kernel.sh
KERNEL_API_KEY=

# Exa — official-domain lookup and scam reports  https://exa.ai
EXA_API_KEY=

# Optional: protects /console and its API. Leave empty for open access on localhost.
CONSOLE_KEY=
